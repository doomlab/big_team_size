\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\centering
\includegraphics{manuscript_files/figure-latex/fig-desc-r1-1.pdf}
\caption{\label{fig:fig-desc-r1}Boxplot of team size by subject areas. The boxplot represents the median (middle bar), the interquartile range (box), and the mean (dot) for each subject area. The plot was capped at 15 for visualization purposes. The size of the mean point represents the sample size of the number of articles used within the calculation. The size of the box represents the standard deviation of the mean for team size (i.e., larger boxes indicate more variance in the team size).}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\centering
\includegraphics{manuscript_files/figure-latex/fig-desc-r1b-1.pdf}
\caption{\label{fig:fig-desc-r1b}Boxplot of citation counts by subject area. The boxplot represents the median (middle bar), the interquartile range (box), and the mean (dot) for overall citations and five year citation count. The plot was capped at 60 citations for visualization purposes. The size of the mean point represents the sample size of the number of articles used within the calculation. The size of the box represents the standard deviation of the mean for citation count (i.e., larger boxes indicate more variance in the citation counts).}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\centering
\includegraphics{manuscript_files/figure-latex/fig-heatmap-1.pdf}
\caption{\label{fig:fig-heatmap}Heatmap of results for coefficients of team size predicting year (top), and team size predicting citation counts while controlling for year (bottom). The effect sizes are also presented for comparison across subject areas.}
\end{figure*}
